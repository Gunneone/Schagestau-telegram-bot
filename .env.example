# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHANNEL_ID=@your_channel
ADMIN_USER_ID=51790129

# Note: To change authorized users for /fire command, edit AUTHORIZED_USERS in src/command_handler.py
# Note: ADMIN_USER_ID is your Telegram user ID (numeric) for receiving article overviews after cron jobs

# Tagesschau API
TAGESSCHAU_API_URL=https://www.tagesschau.de/api2/news/

# Schedule Configuration
FETCH_TIMES=08:00,21:00
TIMEZONE=Europe/Berlin

# Storage
LAST_FETCH_FILE=last_fetch.json
LOG_FILE=bot.log
LOG_LEVEL=INFO

# Optional: News Selection
NEWS_COUNT=3
MAX_SUMMARY_SENTENCES=3
