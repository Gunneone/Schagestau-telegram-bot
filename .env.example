# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.3
OPENAI_MAX_TOKENS=2000

# Telegram Configuration
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
TELEGRAM_CHANNEL_ID=@your_channel
ADMIN_USER_ID=51790129

# Note: To change authorized users for /fire command, edit AUTHORIZED_USERS in src/command_handler.py
# Note: ADMIN_USER_ID is your Telegram user ID (numeric) for receiving article overviews after cron jobs

# Tagesschau API
TAGESSCHAU_API_URL=https://www.tagesschau.de/api2/news/

# Schedule Configuration
FETCH_TIMES=08:00,21:00
TIMEZONE=Europe/Berlin

# Storage
LAST_FETCH_FILE=last_fetch.json
LOG_FILE=bot.log
LOG_LEVEL=INFO

# Optional: News Selection
NEWS_COUNT=3
MAX_SUMMARY_SENTENCES=3
# Articles the ranker shortlists before one-per-topic filtering picks NEWS_COUNT of them
RANKING_CANDIDATE_COUNT=10
# 0.0-1.0: word overlap above which two headlines are treated as the same story (1.0 = off)
TOPIC_SIMILARITY_THRESHOLD=0.5

# Optional: Carry-over pool (unposted articles from earlier runs)
ARTICLE_POOL_FILE=article_pool.json
# Fewer fresh articles than this triggers a top-up from the carry-over pool
MIN_POOL_SIZE=6
# How long an unposted article stays eligible to be carried over
CARRYOVER_MAX_AGE_HOURS=24
# How long posted article ids are remembered
POSTED_RETENTION_HOURS=48
# Skip carried-over articles whose topic was already posted recently
SKIP_CARRYOVER_POSTED_TOPICS=true
